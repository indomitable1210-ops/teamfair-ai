# 이 파일을 복사해 .streamlit/secrets.toml 로 저장하세요 (secrets.toml 은 git 에 올라가지 않음).
# Streamlit Cloud 에서는 앱 Settings → Secrets 에 같은 내용을 붙여넣습니다.

# ── 영구 저장소 (Neon / Supabase 등 무료 Postgres). 비우면 로컬 SQLite 파일(teamfair.db) 사용.
DATABASE_URL = "postgresql://user:password@host/dbname?sslmode=require"

# ── AI 키 (하나만 있어도 AI 모드로 동작)
# GROQ_API_KEY = "gsk_..."
# GEMINI_API_KEY = "..."
# OPENAI_API_KEY = "sk-..."

# ── 구글 소셜 로그인 (Google Cloud Console → API 및 서비스 → 사용자 인증 정보 → OAuth 클라이언트 ID → 웹 애플리케이션)
# '승인된 리디렉션 URI' 에 아래 redirect_uri 를 그대로 등록해야 합니다.
#   로컬:  http://localhost:8501/oauth2callback
#   배포:  https://<앱이름>.streamlit.app/oauth2callback
# 이 [auth] 블록을 지우면 구글 버튼이 숨겨지고 이메일 로그인만 보입니다.
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "여기를 32자 이상의 무작위 문자열로 바꾸세요"

[auth.google]
client_id = "xxxxxxxx.apps.googleusercontent.com"
client_secret = "GOCSPX-..."
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
