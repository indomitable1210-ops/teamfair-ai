# 이 파일을 복사해 .streamlit/secrets.toml 로 저장하세요 (secrets.toml 은 git 에 올라가지 않음).
# Streamlit Cloud 에서는 앱 Settings → Secrets 에 같은 내용을 붙여넣습니다.

# ── 영구 저장소 (Neon / Supabase 등 무료 Postgres). 비우면 로컬 SQLite 파일(teamfair.db) 사용.
DATABASE_URL = "postgresql://user:password@host/dbname?sslmode=require"

# ── AI 키 (하나만 있어도 AI 모드로 동작)
# GROQ_API_KEY = "gsk_..."
# GEMINI_API_KEY = "..."
# OPENAI_API_KEY = "sk-..."
